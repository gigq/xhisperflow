# xhisperflow configuration (all inference runs on this machine)
# Linux: ~/.config/xhisperflow/xhisperflowrc
# macOS: ~/Library/Application Support/xhisperflow/xhisperflowrc
# Inspect raw/final text and timings with: xhisperflow --log

# Speech recognition: install weights with scripts/setup-local-transcription.sh
# --select-model whisper|parakeet|qwen updates both engine and model.
engine                : "whisper"
model                 : "large-v3-turbo" # name or absolute model path
language              : "en" # or auto
threads               : 4
gpu-device            : 0
transcription-timeout : 120 # seconds
transcription-prompt  : ""

# Optional resident VoiceInk cleanup: scripts/setup-local-cleanup.sh
cleanup-enabled       : false
cleanup-timeout-ms    : 750

# Linux insertion: paste (wl-copy + wtype), type, or clipboard (uinput helper).
output-method           : "type"
paste-keys              : "ctrl+v" # also ctrl+shift+v or shift+insert
clipboard-restore-delay : 0.15
non-ascii-initial-delay  : 0.15
non-ascii-default-delay  : 0.025

# Waveform HUD (macOS and Linux)
floating-waveform       : true
waveform-gradient-start : "#b58cff"
waveform-gradient-end   : "#d7e6ff"

# macOS hotkeys; cancel-hotkey may be empty to disable it.
hotkey        : "alt+space"
cancel-hotkey : "ctrl+shift"
